<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ashell Startup"
        android:textSize="24sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/download_default_iso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Download Default Alpine ISO"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/pick_iso_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pick ISO from Storage"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/start_terminal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Terminal" />

</LinearLayout>
